# ==============================================================================
# SmartOCR Finance — Variáveis de Ambiente
# ==============================================================================
# Copie este arquivo para .env e ajuste os valores conforme necessário.
# cp .env.example .env
# ==============================================================================

# ----- Geral -----
# Ambiente de execução: development | staging | production
ENVIRONMENT=development

# ----- Logging -----
# Nível de log: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG
# Diretório para salvar arquivos de log
LOG_DIR=logs
# Tamanho máximo de cada arquivo de log antes de rotacionar (ex: 10 MB)
LOG_ROTATION=10 MB
# Tempo de retenção dos arquivos de log (ex: 7 days)
LOG_RETENTION=7 days

# ----- OCR -----
# Engine de OCR padrão: tesseract | easyocr
OCR_ENGINE=tesseract
# Idioma padrão para OCR
OCR_LANGUAGE=por

# ----- Caminhos (opcional — usa padrões se não definido) -----
# DATA_DIR=data
# MODELS_DIR=models
